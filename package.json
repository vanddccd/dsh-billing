{
  "name": "dsh-billing",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness plugin: 账户余额 + 会话费用（命令/工具 + Web UI 悬浮显示）",
  "main": "host.js",
  "exports": {
    ".": {
      "default": "./host.js"
    },
    "./host.js": "./host.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "client",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanddccd/dsh-billing.git"
  },
  "homepage": "https://github.com/vanddccd/dsh-billing#readme",
  "bugs": {
    "url": "https://github.com/vanddccd/dsh-billing/issues"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
