{
  "name": "dsh-billing",
  "version": "0.4.1",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness plugin: 账户余额 + 会话费用（命令/工具 + Web UI 悬浮显示）",
  "main": "host.js",
  "exports": {
    ".": {
      "default": "./host.js"
    },
    "./host.js": "./host.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
